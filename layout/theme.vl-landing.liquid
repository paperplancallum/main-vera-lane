<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-K7T2KJDFLT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-K7T2KJDFLT');
    </script>
  </head>

  <body class="vl-landing-page">
    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
    >
      {{ content_for_layout }}
    </main>
    <script>
      window.addEventListener("klaviyoForms", function(e) {
        if (e.detail.type === "submit") {
          if (typeof fbq !== "undefined") {
            fbq("track", "Lead", { content_name: "Klaviyo Form Signup" });
          }
        }
      });
    </script>
    <script>
      // Listicle/advertorial -> product detail page click tracking (CTR).
      // Fires to GA4 (reliable) and Meta (direct tr beacon, works even when
      // fbq isn't loaded on landing pages, plus fbq if present).
      (function () {
        var META_PIXEL_ID = "2068875434030572";
        document.addEventListener("click", function (e) {
          var link = e.target.closest ? e.target.closest("a[href]") : null;
          if (!link) return;
          var url;
          try { url = new URL(link.href, window.location.origin); } catch (err) { return; }
          if (url.pathname.indexOf("/products/") !== 0) return;

          var cls = link.className || "";
          var ctaLocation =
            cls.indexOf("vl-lr-offer__btn") > -1 ? "offer" :
            cls.indexOf("vl-lr-final-cta__btn") > -1 ? "final_cta" : "other";
          var pagePath = window.location.pathname;
          var dest = url.pathname;

          if (typeof gtag === "function") {
            gtag("event", "listicle_to_pdp", {
              cta_location: ctaLocation,
              page_path: pagePath,
              link_url: dest
            });
          }
          try {
            var img = new Image();
            img.src = "https://www.facebook.com/tr?id=" + META_PIXEL_ID
              + "&ev=ListicleToPDP"
              + "&cd[cta_location]=" + encodeURIComponent(ctaLocation)
              + "&cd[page_path]=" + encodeURIComponent(pagePath)
              + "&cd[link_url]=" + encodeURIComponent(dest)
              + "&noscript=1";
          } catch (err) {}
          if (typeof fbq === "function") {
            fbq("trackCustom", "ListicleToPDP", {
              cta_location: ctaLocation,
              page_path: pagePath,
              link_url: dest
            });
          }
        }, true);
      })();
    </script>
  </body>
</html>
