{% comment %}
  vl-pdp-three-step
  3-up grid of image-bg cards with a step number badge and a caption strip
  along the bottom of each card. Used on the PDP luxe clone for the
  "Your Daily 3-Step Glow" block.
{% endcomment %}

<section class="vl-pdp-3step" style="
  --bg: {{ section.settings.bg_color }};
  --heading: {{ section.settings.heading_color }};
  --accent: {{ section.settings.accent_color }};
  --card-overlay: {{ section.settings.overlay_color }};
  --card-overlay-text: {{ section.settings.overlay_text_color }};
  --eyebrow: {{ section.settings.eyebrow_color }};
">
  <div class="vl-pdp-3step__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="vl-pdp-3step__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="vl-pdp-3step__heading">
        {{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em class="vl-pdp-3step__accent">{{ section.settings.heading_accent }}</em>{% endif %}
      </h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="vl-pdp-3step__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="vl-pdp-3step__grid">
      {% for block in section.blocks %}
        <article class="vl-pdp-3step__card" {{ block.shopify_attributes }}>
          <div class="vl-pdp-3step__media">
            {% assign img_src = '' %}
            {% if block.settings.image != blank %}
              {% assign img_src = block.settings.image | image_url: width: 900 %}
            {% elsif block.settings.image_asset != blank %}
              {% assign img_src = block.settings.image_asset | asset_url %}
            {% endif %}
            {% if img_src != blank %}
              <img src="{{ img_src }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="vl-pdp-3step__img">
            {% endif %}
            <span class="vl-pdp-3step__badge">Step {{ forloop.index }}</span>
          </div>
          <div class="vl-pdp-3step__caption">
            <h3 class="vl-pdp-3step__title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p class="vl-pdp-3step__text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .vl-pdp-3step { background: var(--bg, #ffffff); padding: 72px 0; }
  .vl-pdp-3step__inner { max-width: 1240px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .vl-pdp-3step__eyebrow { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--eyebrow, #8a6a4a); margin: 0 0 12px; font-weight: 600; }
  .vl-pdp-3step__heading { font-family: var(--font-heading--family, Georgia, serif); font-size: clamp(28px, 3.6vw, 44px); font-weight: 500; color: var(--heading, #111111); margin: 0 0 12px; letter-spacing: -0.01em; }
  .vl-pdp-3step__accent { font-style: italic; font-weight: 500; color: var(--accent, #8a6a4a); }
  .vl-pdp-3step__subheading { font-size: 16px; color: #555; margin: 0 auto 36px; max-width: 580px; line-height: 1.5; }
  .vl-pdp-3step__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .vl-pdp-3step__card { position: relative; border-radius: 14px; overflow: hidden; background: #f6efe5; aspect-ratio: 4 / 5; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
  .vl-pdp-3step__media { position: absolute; inset: 0; }
  .vl-pdp-3step__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vl-pdp-3step__badge { position: absolute; top: 14px; left: 14px; background: #ffffff; color: #111; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 10px; border-radius: 100px; font-weight: 600; box-shadow: 0 2px 6px rgba(0,0,0,0.12); }
  .vl-pdp-3step__caption { position: absolute; left: 14px; right: 14px; bottom: 14px; background: var(--card-overlay, rgba(20, 20, 20, 0.85)); color: var(--card-overlay-text, #ffffff); border-radius: 10px; padding: 14px 16px; text-align: left; backdrop-filter: blur(6px); }
  .vl-pdp-3step__title { font-size: 16px; margin: 0 0 4px; font-weight: 600; letter-spacing: 0.01em; }
  .vl-pdp-3step__text { font-size: 13px; margin: 0; opacity: 0.9; line-height: 1.4; }
  @media (max-width: 900px) {
    .vl-pdp-3step { padding: 48px 0; }
    .vl-pdp-3step__grid { grid-template-columns: 1fr; gap: 14px; }
    .vl-pdp-3step__card { aspect-ratio: 4 / 5; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VL PDP — 3 Step",
  "tag": "section",
  "class": "vl-pdp-3step-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How to use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Daily 3-Step" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "Glow" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Prep, dot, blend — your shade self-adjusts in 30s." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#8B6A4A" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#8B6A4A" },
    { "type": "color", "id": "overlay_color", "label": "Caption overlay bg", "default": "#141414" },
    { "type": "color", "id": "overlay_text_color", "label": "Caption text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image asset filename", "info": "Use instead of picker for theme asset images (e.g. 'lp-step-1.jpg')" },
        { "type": "text", "id": "title", "label": "Title", "default": "Prep" },
        { "type": "textarea", "id": "text", "label": "Caption", "default": "On clean skin, dot a small amount across forehead, cheeks, and chin." }
      ]
    }
  ],
  "presets": [
    {
      "name": "VL PDP — 3 Step",
      "blocks": [
        { "type": "step", "settings": { "title": "Prep", "text": "Start on clean, moisturised skin." } },
        { "type": "step", "settings": { "title": "Dot", "text": "Apply five small dots across your face." } },
        { "type": "step", "settings": { "title": "Blend", "text": "Blend with a brush, sponge, or fingertips." } }
      ]
    }
  ]
}
{% endschema %}
