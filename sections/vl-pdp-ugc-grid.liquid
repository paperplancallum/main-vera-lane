{% comment %}
  vl-pdp-ugc-grid
  4-up (or N-up) UGC still grid with optional play button overlay
  and rounded cards. Used on the PDP luxe clone for "See it in action".
{% endcomment %}

<section class="vl-pdp-ugc" style="
  --bg: {{ section.settings.bg_color }};
  --heading: {{ section.settings.heading_color }};
  --accent: {{ section.settings.accent_color }};
  --eyebrow: {{ section.settings.eyebrow_color }};
">
  <div class="vl-pdp-ugc__inner">
    <div class="vl-pdp-ugc__head">
      {% if section.settings.eyebrow != blank %}
        <p class="vl-pdp-ugc__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="vl-pdp-ugc__heading">
        {{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="vl-pdp-ugc__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="vl-pdp-ugc__grid" data-cols="{{ section.blocks.size | at_most: 4 }}">
      {% for block in section.blocks %}
        {% assign img_src = '' %}
        {% if block.settings.image != blank %}
          {% assign img_src = block.settings.image | image_url: width: 700 %}
        {% elsif block.settings.image_asset != blank %}
          {% assign img_src = block.settings.image_asset | asset_url %}
        {% endif %}
        {% if block.settings.url != blank %}
          <a href="{{ block.settings.url }}" target="_blank" rel="noopener" class="vl-pdp-ugc__card" {{ block.shopify_attributes }}>
        {% else %}
          <div class="vl-pdp-ugc__card" {{ block.shopify_attributes }}>
        {% endif %}
          {% if img_src != blank %}
            <img src="{{ img_src }}" alt="{{ block.settings.caption | default: 'Customer using Vera Lane' | escape }}" loading="lazy" class="vl-pdp-ugc__img">
          {% endif %}
          {% if block.settings.show_play %}
            <span class="vl-pdp-ugc__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M8 5v14l11-7z"/></svg>
            </span>
          {% endif %}
          {% if block.settings.caption != blank %}
            <span class="vl-pdp-ugc__caption">{{ block.settings.caption }}</span>
          {% endif %}
        {% if block.settings.url != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .vl-pdp-ugc { background: var(--bg, #ffffff); padding: 64px 0; }
  .vl-pdp-ugc__inner { max-width: 1240px; margin: 0 auto; padding: 0 24px; }
  .vl-pdp-ugc__head { text-align: center; margin-bottom: 36px; }
  .vl-pdp-ugc__eyebrow { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--eyebrow, #8a6a4a); margin: 0 0 10px; font-weight: 600; }
  .vl-pdp-ugc__heading { font-family: var(--font-heading--family, Georgia, serif); font-size: clamp(26px, 3vw, 38px); font-weight: 500; color: var(--heading, #121212); margin: 0 0 8px; letter-spacing: -0.01em; }
  .vl-pdp-ugc__heading em { font-style: italic; color: var(--accent, #8a6a4a); font-weight: 500; }
  .vl-pdp-ugc__subheading { color: #555; margin: 0; font-size: 15px; }
  .vl-pdp-ugc__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .vl-pdp-ugc__card { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 14px; background: #f0e8db; display: block; box-shadow: 0 8px 22px rgba(0,0,0,0.06); text-decoration: none; }
  .vl-pdp-ugc__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vl-pdp-ugc__play { position: absolute; inset: 0; margin: auto; width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.9); color: #121212; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 18px rgba(0,0,0,0.18); }
  .vl-pdp-ugc__caption { position: absolute; left: 12px; right: 12px; bottom: 12px; background: rgba(20,20,20,0.7); color: #fff; padding: 6px 10px; font-size: 12px; border-radius: 6px; text-align: center; }
  @media (max-width: 900px) {
    .vl-pdp-ugc { padding: 44px 0; }
    .vl-pdp-ugc__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VL PDP — UGC Grid",
  "tag": "section",
  "class": "vl-pdp-ugc-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As seen on social" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "in action" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#8B6A4A" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#8B6A4A" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "UGC tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image asset filename" },
        { "type": "checkbox", "id": "show_play", "label": "Show play button overlay", "default": true },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VL PDP — UGC Grid",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
