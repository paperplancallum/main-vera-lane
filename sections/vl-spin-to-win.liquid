    {
      "type": "richtext",
      "id": "fineprint",
      "label": "Fine print under claim button",
      "default": "<p>By entering your email you agree to receive marketing emails. Unsubscribe anytime.</p>"
    },
    {
      "type": "header",
      "content": "Klaviyo Integration"
    },
    {
      "type": "text",
      "id": "klaviyo_company_id",
      "label": "Klaviyo Company ID",
      "default": "VhFhDd"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo List ID (main marketing list)",
      "default": "RtSate",
      "info": "Default RtSate = Vera Lane Newsletter (main list)."
    },
    {
      "type": "text",
      "id": "klaviyo_source",
      "label": "Klaviyo custom_source tag",
      "default": "ALP-LP1 Spin to Win"
    },
    {
      "type": "text",
      "id": "storage_key",
      "label": "localStorage key (prevents re-showing)",
      "default": "vl_spin_to_win_completed",
      "info": "Change the key to force the popup to re-appear for returning visitors."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay background",
      "default": "#14080edd"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / button color",
      "default": "#7a0036"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "VL Spin to Win Gate"
    }
  ]
}
{% endschema %}
