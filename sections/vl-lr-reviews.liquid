{%- liquid
  assign reviews_count = section.settings.reviews_count | default: '5,000+ Verified Reviews'
  assign heading = section.settings.heading | default: 'What Women Are Saying'
  assign subheading = section.settings.subheading | default: 'Real Transformations From Real Women'
-%}

<section class="vl-lr-reviews">
  <div class="vl-lr-reviews__inner">
    <div class="vl-lr-reviews__rating">
      <div class="vl-lr-reviews__stars" aria-hidden="true">
        {% for i in (1..5) %}
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 15 15" width="16" height="16"><path d="M6.617.924c.3-.92 1.603-.92 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L.548 6.717c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69L6.618.925h-.001z"/></svg>
        {% endfor %}
      </div>
      <div class="vl-lr-reviews__count">{{ reviews_count }}</div>
    </div>

    <h2 class="vl-lr-reviews__h2">{{ heading }}</h2>
    <p class="vl-lr-reviews__sub">{{ subheading }}</p>

    <div class="vl-lr-reviews__grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="vl-lr-reviews__card" {{ block.shopify_attributes }}>
            {% if block.settings.image_asset != blank %}
              <div class="vl-lr-reviews__img">
                <img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="lazy">
              </div>
            {% elsif block.settings.image_url != blank %}
              <div class="vl-lr-reviews__img">
                <img src="{{ block.settings.image_url }}" alt="" loading="lazy">
              </div>
            {% endif %}
            <h4 class="vl-lr-reviews__role">{{ block.settings.name_and_age }} {{ block.settings.stars_text | default: '⭐⭐⭐⭐⭐' }}</h4>
            {% if block.settings.quote != blank %}
              <div class="vl-lr-reviews__quote">{{ block.settings.quote }}</div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .vl-lr-reviews {
    background: #fff;
    color: #000;
    padding: 56px 16px 64px;
    font-family: 'Mulish', ui-sans-serif, system-ui, -apple-system, sans-serif;
  }
  .vl-lr-reviews__inner { max-width: 1280px; margin: 0 auto; text-align: center; }
  .vl-lr-reviews__rating {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .vl-lr-reviews__stars { display: inline-flex; color: #f5a623; gap: 2px; }
  .vl-lr-reviews__stars svg { display: block; }
  .vl-lr-reviews__count { font-size: 14px; color: #333; }
  .vl-lr-reviews__h2 {
    font-family: 'Source Serif 4','Source Serif Pro','Open Sans','Mulish',serif;
    font-weight: 800;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.15;
    color: #000;
    margin: 8px 0 12px;
  }
  .vl-lr-reviews__sub {
    font-size: 16px;
    color: #555;
    margin: 0 auto 32px;
    max-width: 60ch;
  }
  .vl-lr-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    text-align: left;
    max-width: 1080px;
    margin: 0 auto;
  }
  .vl-lr-reviews__card {
    background: #f8f8f8;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
  }
  .vl-lr-reviews__img {
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 16px;
  }
  .vl-lr-reviews__img img { width: 100%; height: auto; display: block; }
  .vl-lr-reviews__role {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #000;
  }
  .vl-lr-reviews__quote {
    font-size: 15px;
    line-height: 1.6;
    color: #444;
  }
  .vl-lr-reviews__quote p { margin: 0 0 12px; }
  .vl-lr-reviews__quote p:last-child { margin-bottom: 0; }

  @media (min-width: 768px) {
    .vl-lr-reviews__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VL LR · Reviews",
  "settings": [
    { "type": "text", "id": "reviews_count", "label": "Reviews count line", "default": "5,000+ Verified Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Women Are Saying" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real Transformations From Real Women" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name_and_age", "label": "Name & age", "default": "Melissa, 47" },
        { "type": "text", "id": "stars_text", "label": "Stars text", "default": "⭐⭐⭐⭐⭐" },
        { "type": "text", "id": "image_asset", "label": "Photo asset filename" },
        { "type": "text", "id": "image_url", "label": "Photo URL (fallback)" },
        { "type": "richtext", "id": "quote", "label": "Quote" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    { "name": "VL LR · Reviews" }
  ]
}
{% endschema %}
