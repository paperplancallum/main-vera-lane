{%- comment -%}
  VL PDP Stats Grid

  Used on the Luxe-clone PDP to mirror the competitor's
  "Last Foundation You'll Ever Buy" + percentage results grid:
    94% Found their perfect shade match on first try
    91% Achieved 'no-makeup makeup' look
    ...etc.

  Layout: optional eyebrow + headline + sub-copy on top,
  responsive grid of stat cards (percentage + statement) below.
{%- endcomment -%}

<section
  class="vl-pdp-stats-grid"
  id="vl-pdp-stats-grid-{{ section.id }}"
  style="
    --vl-stats-bg: {{ section.settings.bg_color }};
    --vl-stats-heading-color: {{ section.settings.heading_color }};
    --vl-stats-text-color: {{ section.settings.text_color }};
    --vl-stats-accent-color: {{ section.settings.accent_color }};
    --vl-stats-card-bg: {{ section.settings.card_bg_color }};
    --vl-stats-card-border: {{ section.settings.card_border_color }};
  ">
  <div class="vl-pdp-stats-grid__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="vl-pdp-stats-grid__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="vl-pdp-stats-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="vl-pdp-stats-grid__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="vl-pdp-stats-grid__list" role="list">
        {%- for block in section.blocks -%}
          <li class="vl-pdp-stats-grid__card" {{ block.shopify_attributes }}>
            <span class="vl-pdp-stats-grid__pct">{{ block.settings.percentage }}</span>
            <span class="vl-pdp-stats-grid__statement">{{ block.settings.statement }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="vl-pdp-stats-grid__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .vl-pdp-stats-grid {
    background-color: var(--vl-stats-bg, #FBF8F6);
    padding: 64px 20px;
  }

  .vl-pdp-stats-grid__inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .vl-pdp-stats-grid__eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vl-stats-accent-color, #5C1A33);
    margin: 0 0 12px;
  }

  .vl-pdp-stats-grid__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 36px;
    line-height: 1.15;
    color: var(--vl-stats-heading-color, #1a1a1a);
    margin: 0 0 14px;
  }

  .vl-pdp-stats-grid__subheading {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--vl-stats-text-color, #444);
    margin: 0 auto 40px;
    max-width: 640px;
  }

  .vl-pdp-stats-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
  }

  .vl-pdp-stats-grid__card {
    background-color: var(--vl-stats-card-bg, #FFFFFF);
    border: 1px solid var(--vl-stats-card-border, #E1DCD8);
    border-radius: 12px;
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .vl-pdp-stats-grid__pct {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 1;
    color: var(--vl-stats-accent-color, #5C1A33);
  }

  .vl-pdp-stats-grid__statement {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: var(--vl-stats-text-color, #333);
    text-align: center;
  }

  .vl-pdp-stats-grid__footnote {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: var(--vl-stats-text-color, #666);
    opacity: 0.75;
    margin: 32px auto 0;
    max-width: 640px;
  }

  @media screen and (max-width: 768px) {
    .vl-pdp-stats-grid { padding: 48px 16px; }
    .vl-pdp-stats-grid__heading { font-size: 28px; }
    .vl-pdp-stats-grid__pct { font-size: 40px; }
  }
</style>

{% schema %}
{
  "name": "VL PDP Stats Grid",
  "tag": "section",
  "class": "vl-pdp-stats-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Last Foundation You'll Ever Buy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real results, from real women"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Independent survey of 1,356 verified Vera Lane customers."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "info": "Optional small print below the grid"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FBF8F6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Percentage accent color",
      "default": "#5C1A33"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#E1DCD8"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "percentage",
          "label": "Percentage / number",
          "default": "94%"
        },
        {
          "type": "textarea",
          "id": "statement",
          "label": "Statement",
          "default": "Found their perfect shade match on first try"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VL PDP Stats Grid",
      "blocks": [
        { "type": "stat", "settings": { "percentage": "94%", "statement": "Found their perfect shade match on first try" } },
        { "type": "stat", "settings": { "percentage": "91%", "statement": "Achieved a no-makeup makeup look" } },
        { "type": "stat", "settings": { "percentage": "89%", "statement": "Cut their morning routine to under 5 minutes" } },
        { "type": "stat", "settings": { "percentage": "85%", "statement": "Stopped carrying concealer or powder for touch-ups" } },
        { "type": "stat", "settings": { "percentage": "81%", "statement": "Got compliments on their skin within a week" } }
      ]
    }
  ]
}
{% endschema %}
