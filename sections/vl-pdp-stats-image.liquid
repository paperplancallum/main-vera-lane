{% comment %}
  vl-pdp-stats-image
  Two-column block: image on the left, headline + 5 stat rows on the right.
  Each stat row is a circular percentage badge + label.
  Used on the PDP luxe clone for "The Last Foundation You'll Ever Buy".
{% endcomment %}

<section class="vl-pdp-stats" id="{{ section.settings.section_id }}" style="
  --bg: {{ section.settings.bg_color }};
  --heading: {{ section.settings.heading_color }};
  --accent: {{ section.settings.accent_color }};
  --eyebrow: {{ section.settings.eyebrow_color }};
  --stat-bg: {{ section.settings.stat_bg_color }};
  --stat-text: {{ section.settings.stat_text_color }};
">
  <div class="vl-pdp-stats__inner">
    <div class="vl-pdp-stats__media">
      {% assign img_src = '' %}
      {% if section.settings.image != blank %}
        {% assign img_src = section.settings.image | image_url: width: 1200 %}
      {% elsif section.settings.image_asset != blank %}
        {% assign img_src = section.settings.image_asset | asset_url %}
      {% endif %}
      {% if img_src != blank %}
        <img src="{{ img_src }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" class="vl-pdp-stats__img">
      {% endif %}
    </div>

    <div class="vl-pdp-stats__body">
      {% if section.settings.eyebrow != blank %}
        <p class="vl-pdp-stats__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="vl-pdp-stats__heading">
        {{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="vl-pdp-stats__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <ul class="vl-pdp-stats__list">
        {% for block in section.blocks %}
          <li class="vl-pdp-stats__row" {{ block.shopify_attributes }}>
            <div class="vl-pdp-stats__circle">
              <span class="vl-pdp-stats__pct">{{ block.settings.percent }}</span>
              <span class="vl-pdp-stats__pct-sign">%</span>
            </div>
            <p class="vl-pdp-stats__label">{{ block.settings.label }}</p>
          </li>
        {% endfor %}
      </ul>

      {% if section.settings.footnote != blank %}
        <p class="vl-pdp-stats__footnote">{{ section.settings.footnote }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .vl-pdp-stats { background: var(--bg, #faf7f2); padding: 84px 0; }
  .vl-pdp-stats__inner { max-width: 1240px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .vl-pdp-stats__media { border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 5; background: #eee; box-shadow: 0 14px 40px rgba(0,0,0,0.07); }
  .vl-pdp-stats__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vl-pdp-stats__eyebrow { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--eyebrow, #8a6a4a); margin: 0 0 12px; font-weight: 600; }
  .vl-pdp-stats__heading { font-family: var(--font-heading--family, Georgia, serif); font-size: clamp(28px, 3.2vw, 42px); font-weight: 500; color: var(--heading, #121212); margin: 0 0 14px; letter-spacing: -0.01em; line-height: 1.1; }
  .vl-pdp-stats__heading em { font-style: italic; color: var(--accent, #8a6a4a); font-weight: 500; }
  .vl-pdp-stats__subheading { color: #555; margin: 0 0 28px; font-size: 16px; line-height: 1.5; max-width: 480px; }
  .vl-pdp-stats__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .vl-pdp-stats__row { display: grid; grid-template-columns: 72px 1fr; align-items: center; gap: 18px; }
  .vl-pdp-stats__circle { width: 72px; height: 72px; border-radius: 50%; background: var(--stat-bg, #5d1f33); color: var(--stat-text, #ffffff); display: flex; align-items: center; justify-content: center; font-family: var(--font-heading--family, Georgia, serif); font-weight: 500; line-height: 1; }
  .vl-pdp-stats__pct { font-size: 24px; letter-spacing: -0.01em; line-height: 1; }
  .vl-pdp-stats__pct-sign { font-size: 14px; line-height: 1; opacity: 0.92; margin-left: 1px; }
  .vl-pdp-stats__label { margin: 0; color: #333; font-size: 15px; line-height: 1.45; }
  .vl-pdp-stats__footnote { margin: 28px 0 0; font-size: 12px; color: #888; line-height: 1.5; }
  @media (max-width: 900px) {
    .vl-pdp-stats { padding: 56px 0; }
    .vl-pdp-stats__inner { grid-template-columns: 1fr; gap: 32px; }
    .vl-pdp-stats__media { aspect-ratio: 16 / 12; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VL PDP — Stats + Image",
  "tag": "section",
  "class": "vl-pdp-stats-section",
  "settings": [
    { "type": "text", "id": "section_id", "label": "Section ID" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image asset filename", "info": "Use instead of picker for theme asset images" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Before and after using Vera Lane Tone-Adapting Foundation" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Last Foundation You'll Ever Buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real results from women who" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "demanded better" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Independent 30-day survey of 1,356 verified Vera Lane customers, age 40+." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Survey conducted by Vera Lane Customer Insights, 2026. Self-reported results from verified buyers." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF7F2" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#8B6A4A" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#8B6A4A" },
    { "type": "color", "id": "stat_bg_color", "label": "Stat circle bg", "default": "#5D1F33" },
    { "type": "color", "id": "stat_text_color", "label": "Stat circle text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat row",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "percent", "label": "Percent (number only)", "default": "94" },
        { "type": "textarea", "id": "label", "label": "Description", "default": "Found their perfect shade on the first try" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VL PDP — Stats + Image",
      "blocks": [
        { "type": "stat", "settings": { "percent": "94", "label": "Found their perfect shade on the first try" } },
        { "type": "stat", "settings": { "percent": "91", "label": "Achieved a 'no-makeup makeup' finish" } },
        { "type": "stat", "settings": { "percent": "89", "label": "Cut their morning routine from 15+ to under 5 minutes" } },
        { "type": "stat", "settings": { "percent": "85", "label": "Stopped carrying concealer or powder for touch-ups" } },
        { "type": "stat", "settings": { "percent": "81", "label": "Received compliments on their skin within the first week" } }
      ]
    }
  ]
}
{% endschema %}
