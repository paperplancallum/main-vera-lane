{% comment %}
  VL Message Match Hero
  ---------------------
  Shows a variant-specific hero headline/subhead when ?v=a/b/c/d is in the URL.
  Hides the default title in lumen-pdp-hero so there's no redundancy.
  When no ?v= param, section is invisible and the default PDP renders normally.
{% endcomment %}

<style>
  .vl-mmh {
    display: none;
    padding: 48px 24px 32px;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    font-family: var(--font-body--family, 'Montserrat', sans-serif);
  }

  .vl-mmh.is-active {
    display: block;
  }

  .vl-mmh--with-image {
    max-width: 1040px;
  }

  .vl-mmh__hero {
    display: grid;
    grid-template-columns: 1fr 2fr;
    grid-template-areas:
      "image headline"
      "image subhead";
    gap: 24px 32px;
    align-items: center;
    text-align: left;
    margin: 0 0 24px;
  }

  .vl-mmh__image-wrap {
    display: block;
    line-height: 0;
    grid-area: image;
    align-self: center;
  }

  .vl-mmh__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .vl-mmh__hero .vl-mmh__headline { grid-area: headline; }
  .vl-mmh__hero .vl-mmh__subhead { grid-area: subhead; }

  .vl-mmh__headline {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    line-height: 1.25;
    color: #1a1a1a;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .vl-mmh__subhead {
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.6;
    color: #555;
    margin: 0 0 28px;
    font-weight: 400;
  }

  .vl-mmh__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    text-align: left;
    margin: 0 0 28px;
  }

  .vl-mmh__col-title {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1a1a1a;
    margin: 0 0 8px;
  }

  .vl-mmh__col-text {
    font-size: 15px;
    line-height: 1.6;
    color: #555;
    margin: 0;
  }

  .vl-mmh__divider {
    width: 40px;
    height: 2px;
    background: #e0d6cf;
    margin: 0 auto 24px;
  }

  /* Hide the default description in lumen-pdp-hero when variant is active. Keep the title visible. */
  body.has-mmh .lumen-pdp-hero__description {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .vl-mmh {
      padding: 32px 20px 24px;
    }

    .vl-mmh__columns {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vl-mmh__hero {
      grid-template-columns: clamp(88px, 26vw, 120px) 1fr;
      grid-template-areas:
        "image headline"
        "subhead subhead";
      gap: 14px 16px;
      text-align: left;
    }

    .vl-mmh__hero .vl-mmh__image-wrap { align-self: start; }
    .vl-mmh__hero .vl-mmh__headline {
      font-size: clamp(20px, 5.5vw, 26px);
      margin: 0;
    }
    .vl-mmh__hero .vl-mmh__subhead {
      font-size: 15px;
      margin: 0;
    }
  }
</style>

{% for block in section.blocks %}
  {%- assign mmh_img_src = '' -%}
  {%- assign mmh_img_alt = block.settings.headline | default: 'Vera Lane' -%}
  {%- if block.settings.image_asset != blank -%}
    {%- assign mmh_img_src = block.settings.image_asset | asset_url -%}
  {%- elsif block.settings.hero_image != blank -%}
    {%- assign mmh_img_src = block.settings.hero_image | image_url: width: 800 -%}
    {%- assign mmh_img_alt = block.settings.hero_image.alt | default: mmh_img_alt -%}
  {%- endif -%}
  {%- assign has_image = false -%}
  {%- if mmh_img_src != '' -%}
    {%- assign has_image = true -%}
  {%- endif -%}
  <div
    class="vl-mmh{% if has_image %} vl-mmh--with-image{% endif %}"
    data-mmh-variant="{{ block.settings.variant_key }}"
    id="vl-mmh-{{ block.settings.variant_key }}"
    {{ block.shopify_attributes }}
  >
    <div class="vl-mmh__divider"></div>

    {% if has_image %}
      <div class="vl-mmh__hero">
        <div class="vl-mmh__image-wrap">
          <img
            class="vl-mmh__image"
            src="{{ mmh_img_src }}"
            alt="{{ mmh_img_alt | escape }}"
            loading="lazy"
          />
        </div>
        {% if block.settings.headline != blank %}
          <h2 class="vl-mmh__headline">{{ block.settings.headline }}</h2>
        {% endif %}
        {% unless block.settings.use_columns %}
          {% if block.settings.subhead != blank %}
            <p class="vl-mmh__subhead">{{ block.settings.subhead }}</p>
          {% endif %}
        {% endunless %}
      </div>
    {% else %}
      {% if block.settings.headline != blank %}
        <h2 class="vl-mmh__headline">{{ block.settings.headline }}</h2>
      {% endif %}
      {% unless block.settings.use_columns %}
        {% if block.settings.subhead != blank %}
          <p class="vl-mmh__subhead">{{ block.settings.subhead }}</p>
        {% endif %}
      {% endunless %}
    {% endif %}

    {% if block.settings.use_columns %}
      <div class="vl-mmh__columns">
        <div>
          {% if block.settings.col_1_title != blank %}
            <p class="vl-mmh__col-title">{{ block.settings.col_1_title }}</p>
          {% endif %}
          {% if block.settings.col_1_text != blank %}
            <p class="vl-mmh__col-text">{{ block.settings.col_1_text }}</p>
          {% endif %}
        </div>
        <div>
          {% if block.settings.col_2_title != blank %}
            <p class="vl-mmh__col-title">{{ block.settings.col_2_title }}</p>
          {% endif %}
          {% if block.settings.col_2_text != blank %}
            <p class="vl-mmh__col-text">{{ block.settings.col_2_text }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.reinforcement != blank %}
      <template data-mmh-reinforcement-for="{{ block.settings.variant_key }}">{{ block.settings.reinforcement | newline_to_br }}</template>
    {% endif %}

  </div>
{% endfor %}

{% comment %}
  Quiz-funnel persona variants (?v=chameleon/glow/calm/timeless[-age-tone]).
  Rendered INLINE here (not as theme-editor blocks) so they deploy reliably via the
  GitHub->Shopify section sync — JSON product templates are customizer-owned and do
  not reliably sync block additions from Git. The legacy a..f/kbeauty variants above
  stay as template blocks. Default image is the 35-medium house shot; JS swaps it to
  the age+tone-matched model from the image map below.
{% endcomment %}
{%- assign mmh_default_img = 'lp-foundation-mmh-35-medium.jpg' | asset_url -%}
{%- assign p_keys = "chameleon|||glow|||calm|||timeless" | split: "|||" -%}
{%- assign p_heads = "If your foundation looks right at home and orange by noon, the problem was never your shade.|||If skin tints do too little and foundation does too much, you've been choosing between the wrong two things.|||If evening out redness takes three products and five steps, this does it in one.|||If your foundation looks fine across the room but settles into every line up close, you've been sold the wrong formula." | split: "|||" -%}
{%- assign p_subs = "Right shade in the bathroom mirror, wrong shade — and a tell-tale line at your jaw — a few hours later. That's oxidation: pre-mixed pigment reacting with your skin through the day. Vera Lane has no pre-mixed shade to oxidise. The cream is white and releases your exact tone on contact, so there's nothing to drift orange and no line where your face stops and your neck begins.|||Skin tints leave you basically bare; full-coverage sits on top like a mask and kills the glow. Vera Lane is the in-between you actually wanted: weightless and hydrating like a serum, it releases just enough pigment on contact to even your tone — buildable if you want more — while your skin still looks like skin. A real glass-skin glow, not a coat of base.|||Colour-correctors, full-coverage, powder to lock it down — and the redness still shows through, or the layers make your skin look worse. Vera Lane evens tone and visibly softens the look of redness in a single lightweight step. It releases pigment on contact to neutralise unevenness, then sits like skin instead of stacked makeup — no cake, no five-step routine.|||Long-wear foundations were built to seal and set — fine at 25, but on mature skin they catch in fine lines and go cakey by mid-afternoon. Vera Lane does the opposite: it hydrates like a serum and releases pigment on contact, so it adapts to your skin instead of sitting on top of it. Even tone that still moves like skin — close-up and late in the day, not just from across the room." | split: "|||" -%}
{%- assign p_reins = "No pre-mixed shade means nothing to oxidise or drift — your own tone, released on contact. Try it risk-free for 30 days.|||Serum-light, tone-adapting, buildable — coverage that still reads as your own skin. Try it risk-free for 30 days.|||One lightweight step that evens tone and softens the appearance of redness — no colour-correcting, no stacking. Try it risk-free for 30 days.|||Hydrating, tone-adapting, never cakey — coverage that looks like skin up close, not makeup catching in lines. Try it risk-free for 30 days." | split: "|||" -%}
{%- for pk in p_keys -%}
  {%- assign i = forloop.index0 -%}
  <div class="vl-mmh vl-mmh--with-image" data-mmh-variant="{{ pk }}" id="vl-mmh-{{ pk }}">
    <div class="vl-mmh__divider"></div>
    <div class="vl-mmh__hero">
      <div class="vl-mmh__image-wrap">
        <img class="vl-mmh__image" src="{{ mmh_default_img }}" alt="Vera Lane" loading="lazy" />
      </div>
      <h2 class="vl-mmh__headline">{{ p_heads[i] }}</h2>
      <p class="vl-mmh__subhead">{{ p_subs[i] }}</p>
    </div>
    <template data-mmh-reinforcement-for="{{ pk }}">{{ p_reins[i] }}</template>
  </div>
{%- endfor -%}

{% comment %}
  Age clauses (light copy tweak appended to the subhead by ?v=persona-AGE-tone).
  One shared set across all personas — rendered hidden so JS reads the text. Inline
  for the same deploy-reliability reason as the persona variants above.
{% endcomment %}
{%- assign a_keys = "18,25,35,45,55" | split: "," -%}
{%- assign a_clauses = "And because it's weightless and skin-like, it's the rare base that never feels like makeup.|||Fast enough for a morning already running late — and it still looks like you by evening.|||Right as skin starts to shift, it adapts with you instead of fighting you.|||On skin that's drier than it used to be, the hydration keeps it from catching or going flat.|||If you'd quietly given up on foundation, this is the one built to behave on mature skin." | split: "|||" -%}
{%- for ak in a_keys -%}
  <template data-mmh-age-clause="{{ ak }}">{{ a_clauses[forloop.index0] }}</template>
{%- endfor -%}

{% comment %}
  Demographic image map: age (18/25/35/45/55) x tone (fair/medium/mediumdark).
  Asset filename convention: lp-foundation-mmh-<age>-<tone>.jpg. Liquid resolves the
  asset URLs here so the JS (which can't call asset_url) can swap the hero <img> src.
{% endcomment %}
{%- assign mmh_ages = "18,25,35,45,55" | split: "," -%}
{%- assign mmh_tones = "fair,medium,mediumdark" | split: "," -%}
<script type="application/json" data-mmh-image-map>
{
{%- for age in mmh_ages -%}
  {%- for tone in mmh_tones -%}
    {%- assign mmh_file = 'lp-foundation-mmh-' | append: age | append: '-' | append: tone | append: '.jpg' -%}
    "{{ age }}-{{ tone }}": "{{ mmh_file | asset_url }}"{% unless forloop.last and forloop.parentloop.last %},{% endunless %}
  {%- endfor -%}
{%- endfor -%}
}
</script>

<script>
  (function() {
    var params = new URLSearchParams(window.location.search);
    var variant = params.get('v');
    if (!variant) return;

    // Parse persona-age-tone. Single-token keys (a..f, kbeauty) parse to persona only
    // and keep their original behaviour (no image swap / no age clause).
    var parts = variant.split('-');
    var persona = parts[0];
    var age = parts.length >= 3 ? parts[1] : null;
    var tone = parts.length >= 3 ? parts[2] : null;

    // Match the copy block by persona token first, then by the full key (back-compat).
    var hero = document.querySelector('[data-mmh-variant="' + persona + '"]')
            || document.querySelector('[data-mmh-variant="' + variant + '"]');
    if (!hero) return;

    // Show the matching hero
    hero.classList.add('is-active');
    document.body.classList.add('has-mmh');

    // Swap the hero image to the age+tone-matched model (falls back to the block's
    // authored default image if no map entry / the file 404s).
    if (age && tone) {
      try {
        var mapEl = document.querySelector('script[data-mmh-image-map]');
        var imgMap = mapEl ? JSON.parse(mapEl.textContent) : {};
        var src = imgMap[age + '-' + tone];
        var img = hero.querySelector('.vl-mmh__image');
        if (src && img) {
          img.addEventListener('error', function onErr() {
            // leave the authored default in place if the demographic asset is missing
            img.removeEventListener('error', onErr);
          });
          img.src = src;
        }
      } catch (e) {}
    }

    // Append the age clause to the subhead (localized text comes from the template).
    if (age) {
      var clauseTpl = document.querySelector('template[data-mmh-age-clause="' + age + '"]');
      var subhead = hero.querySelector('.vl-mmh__subhead');
      if (clauseTpl && subhead && clauseTpl.innerHTML.trim() !== '') {
        subhead.innerHTML = subhead.innerHTML.replace(/\s+$/, '') + ' ' + clauseTpl.innerHTML.trim();
      }
    }

    // Inject this persona's reinforcement copy into the buy box slot once the DOM is parsed
    // (the slot lives in lumen-pdp-hero, which renders below this script in the document)
    var injectReinforcement = function() {
      var reinforcementTpl = document.querySelector('template[data-mmh-reinforcement-for="' + persona + '"]')
                          || document.querySelector('template[data-mmh-reinforcement-for="' + variant + '"]');
      var reinforcementSlot = document.querySelector('[data-mmh-reinforcement-slot]');
      if (reinforcementTpl && reinforcementSlot && reinforcementTpl.innerHTML.trim() !== '') {
        reinforcementSlot.innerHTML = reinforcementTpl.innerHTML;
        reinforcementSlot.hidden = false;
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', injectReinforcement);
    } else {
      injectReinforcement();
    }

    var trackParams = { variant_key: variant, persona: persona, age: age || '', tone: tone || '' };

    // GA4 tracking
    if (typeof gtag === 'function') {
      gtag('event', 'message_match_variant_viewed', trackParams);
    }

    // Meta Pixel tracking
    if (typeof fbq === 'function') {
      fbq('trackCustom', 'MessageMatchVariantViewed', trackParams);
    }
  })();
</script>

{% schema %}
{
  "name": "VL Message Match Hero",
  "tag": "section",
  "class": "vl-message-match-hero-section",
  "settings": [],
  "blocks": [
    {
      "type": "variant",
      "name": "Hero Variant",
      "settings": [
        {
          "type": "text",
          "id": "variant_key",
          "label": "Variant key",
          "info": "Matches the ?v= URL parameter (e.g., a, b, c, d)"
        },
        {
          "type": "image_picker",
          "id": "hero_image",
          "label": "Hero image",
          "info": "Optional. Shown left of the headline on desktop, stacked on mobile."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Hero image (asset filename)",
          "info": "Optional. Filename in /assets/, e.g. lp-foundation-mmh-a.jpg. Takes precedence over Hero image picker if set."
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline"
        },
        {
          "type": "textarea",
          "id": "subhead",
          "label": "Subhead"
        },
        {
          "type": "checkbox",
          "id": "use_columns",
          "label": "Use two-column layout",
          "default": false,
          "info": "For the skeptic variant (what it is / what it isn't)"
        },
        {
          "type": "text",
          "id": "col_1_title",
          "label": "Column 1 title",
          "info": "Only used when two-column layout is enabled"
        },
        {
          "type": "textarea",
          "id": "col_1_text",
          "label": "Column 1 text"
        },
        {
          "type": "text",
          "id": "col_2_title",
          "label": "Column 2 title"
        },
        {
          "type": "textarea",
          "id": "col_2_text",
          "label": "Column 2 text"
        },
        {
          "type": "textarea",
          "id": "reinforcement",
          "label": "Reinforcement text",
          "info": "Optional. Renders below the headline/subhead/columns. Use to reinforce the angle and tie it back to the product characteristics that solve the problem."
        }
      ]
    },
    {
      "type": "age_clause",
      "name": "Age Clause",
      "settings": [
        {
          "type": "text",
          "id": "age_key",
          "label": "Age key",
          "info": "Lower bound of the quiz age range: 18, 25, 35, 45 or 55. Matches the AGE token in ?v=persona-AGE-tone."
        },
        {
          "type": "textarea",
          "id": "clause",
          "label": "Clause appended to the subhead",
          "info": "Short life-stage line added to the end of the persona subhead for this age band. Shared across all personas."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VL Message Match Hero"
    }
  ]
}
{% endschema %}
