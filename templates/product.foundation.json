    "vl_message_match_hero": {
      "type": "vl-message-match-hero",
      "blocks": {
        "variant_a": {
          "type": "variant",
          "settings": {
            "variant_key": "a",
            "image_asset": "lp-foundation-mmh-a.jpg",
            "headline": "If you've quietly stopped buying foundation, this might be the one worth opening the drawer for.",
            "subhead": "I didn't even mean to quit. It just stopped working — orange by lunch, settled into every fine line, more effort than it was worth. Vera Lane releases pigment on contact with your skin instead of fighting it. Same drawer. Different ending.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": "This is the reinforcement text area"
          }
        },
        "variant_b": {
          "type": "variant",
          "settings": {
            "variant_key": "b",
            "image_asset": "lp-foundation-mmh-b.jpg",
            "headline": "If your foundation keeps turning orange by lunch, it's not your shade. It's the formula.",
            "subhead": "If you've already tried a lighter shade, primer, setting powder, swapping brands — the problem isn't your routine. It's oxidation. Vera Lane skips the pre-mixed pigment that causes it: the cream releases your tone on contact, so there's no shade to drift.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": ""
          }
        },
        "variant_c": {
          "type": "variant",
          "settings": {
            "variant_key": "c",
            "image_asset": "lp-foundation-mmh-c.jpg",
            "headline": "If you don't believe foundation ads anymore, here's one that doesn't ask you to.",
            "subhead": "We're not going to tell you it's revolutionary, show a before/after with different lighting, or quote a celebrity. We're selling you a foundation built on a different mechanism — pigment that releases on contact with your skin, not pre-mixed in the bottle. Backed by 30 days, no questions, full refund including return shipping. The mechanism either works on your skin or it doesn't.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": ""
          }
        },
        "variant_d": {
          "type": "variant",
          "settings": {
            "variant_key": "d",
            "image_asset": "lp-foundation-mmh-d.jpg",
            "headline": "If your foundation breaks during a hot flash, you've been sold the wrong category.",
            "subhead": "Long-wear was built to seal surfaces, control shine, and lock pigment in place — designed for a 25-year-old bride at her wedding. Menopausal skin needs the opposite: hydration that holds through a hot flash, a formula that adapts when chemistry shifts, pigment that releases on contact instead of sitting on top of dehydrated skin.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": ""
          }
        },
        "variant_e": {
          "type": "variant",
          "settings": {
            "variant_key": "e",
            "image_asset": "lp-foundation-mmh-e.jpg",
            "headline": "If you've rolled your eyes at every \"adapts to your tone\" ad, this is the one to actually try.",
            "subhead": "I rolled my eyes at \"adapts to your skin tone\" the first three times I saw it. I tried it the fourth time only because of the 30-day guarantee — no questions, full refund, return shipping included. Two months later it's the only foundation I'm wearing. I'm not saying it's magic. I'm saying it worked.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": ""
          }
        },
        "variant_f": {
          "type": "variant",
          "settings": {
            "variant_key": "f",
            "image_asset": "lp-foundation-mmh-f.jpg",
            "headline": "If you've spent hundreds finding \"the right shade\", try the one that adapts to you instead.",
            "subhead": "#1 was the wrong shade. #5 oxidized. #9 settled into every line. Eleven close-but-no purchases and you've quietly spent the price of a designer bag. If the next one costs $40 and comes with a 30-day refund, the math is already decided.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": ""
          }
        },
        "variant_kbeauty": {
          "type": "variant",
          "settings": {
            "variant_key": "kbeauty",
            "image_asset": "lp-foundation-mmh-kbeauty.jpg",
            "headline": "A Korean-developed skincare-foundation hybrid — scientifically engineered to treat your skin while it covers it.",
            "subhead": "This isn't a makeup-aisle foundation. It was developed in Korea by skincare scientists as a true hybrid: hydrating and weightless like a serum, it releases pigment on contact with your skin to match your exact tone — leaving a glass-skin glow instead of a mask. No orange cast, no cake, no 'wrong shade'. The combination that went viral on TikTok, exclusive to Vera Lane and backed by 30 days, no questions, full refund.",
            "use_columns": false,
            "col_1_title": "",
            "col_1_text": "",
            "col_2_title": "",
            "col_2_text": "",
            "reinforcement": "A Korean-developed skincare-foundation hybrid you won't find anywhere else — hydrating, tone-adapting, zero orange cast. Try it risk-free for 30 days."
          }
        }
      },
      "block_order": [
